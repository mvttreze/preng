rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared message wall for Teachers Day site (GitHub Pages = no backend, so open read + limited write)
    match /messages/{docId} {
      allow read: if true;
      allow create: if request.resource.data.m is string
        && request.resource.data.m.size() > 0
        && request.resource.data.m.size() <= 300
        && request.resource.data.n is string
        && request.resource.data.n.size() <= 40;
      allow update, delete: if false; // no editing via site
    }
  }
}
